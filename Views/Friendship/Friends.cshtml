@model List<ActTogether.Models.User>
@{
    ViewData["Title"] = "My Friends";
}

<div class="main-content">
    <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>

    <h3>My Friends</h3>

    @if (Model.Any())
    {
        @foreach (var friend in Model)
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            @if (!string.IsNullOrEmpty(friend.ProfileImageUrl))
                            {
                                <img src="@friend.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <span class="text-white" style="font-size: 1.25rem;">@friend.Username.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                        </div>
                        <div>
                            <strong>@friend.Username</strong>
                            @if (!string.IsNullOrEmpty(friend.FullName))
                            {
                                <span class="text-muted">- @friend.FullName</span>
                            }
                        </div>
                    </div>
                    <div>
                        <a asp-action="Profile" asp-controller="User" asp-route-id="@friend.Id" class="btn btn-sm btn-outline-primary me-1">View Profile</a>
                        <form asp-action="Remove" asp-route-id="@friend.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">No friends yet. <a asp-action="Search" asp-controller="User">Search for users</a> to add friends.</p>
    }
</div>
