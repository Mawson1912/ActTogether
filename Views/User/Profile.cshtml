@model ActTogether.Models.User
@{
    ViewData["Title"] = Model.Username + "'s Profile";
    var friendship = ViewBag.FriendshipStatus as ActTogether.Models.Friendship;
    bool isOwn = ViewBag.IsOwnProfile;
    bool isFriend = ViewBag.IsFriend;
    int currentUserId = ViewBag.CurrentUserId;
}

<a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h3>@Model.Username</h3>
                @if (!string.IsNullOrEmpty(Model.FullName))
                {
                    <p class="text-muted">@Model.FullName</p>
                }
                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p>@Html.Raw(Model.Bio.Replace("\n", "<br />"))</p>
                }
                <p class="text-muted small">Joined @Model.CreatedAt.ToString("MMM yyyy")</p>

                @if (isOwn)
                {
                    <a asp-action="Edit" class="btn btn-sm btn-outline-primary">Edit Profile</a>
                }
                else if (friendship == null)
                {
                    <form asp-action="SendRequest" asp-controller="Friendship" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-primary">Add Friend</button>
                    </form>
                }
                else if (friendship.Status == "Pending" && friendship.RequestedBy == currentUserId)
                {
                    <span class="badge bg-warning">Request Sent</span>
                }
                else if (friendship.Status == "Pending" && friendship.RequestedBy != currentUserId)
                {
                    <form asp-action="Accept" asp-controller="Friendship" asp-route-id="@friendship.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Accept Request</button>
                    </form>
                }
                else if (friendship.Status == "Accepted")
                {
                    <span class="badge bg-success me-2">Friends</span>
                    <form asp-action="Remove" asp-controller="Friendship" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove Friend</button>
                    </form>
                }
                else if (friendship.Status == "Blocked" && friendship.BlockedBy == currentUserId)
                {
                    <form asp-action="Unblock" asp-controller="Friendship" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Unblock</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <h4>Posts</h4>
        <p class="text-muted">Posts will be added in a future update.</p>
    </div>
</div>
