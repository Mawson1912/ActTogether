@model ActTogether.Models.User
@{
    ViewData["Title"] = Model.Username + "'s Profile";
    var friendship = ViewBag.FriendshipStatus as ActTogether.Models.Friendship;
    bool isOwn = ViewBag.IsOwnProfile;
    bool isFriend = ViewBag.IsFriend;
    int currentUserId = ViewBag.CurrentUserId;
    var posts = ViewBag.Posts as List<ActTogether.Models.Post>;
}

<a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h3>@Model.Username</h3>
                @if (!string.IsNullOrEmpty(Model.FullName))
                {
                    <p class="text-muted">@Model.FullName</p>
                }
                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p>@Html.Raw(Model.Bio.Replace("\n", "<br />"))</p>
                }
                <p class="text-muted small">Joined @Model.CreatedAt.ToString("MMM yyyy")</p>

                @if (isOwn)
                {
                    <a asp-action="Edit" class="btn btn-sm btn-outline-primary">Edit Profile</a>
                }
                else if (friendship == null)
                {
                    <form asp-action="SendRequest" asp-controller="Friendship" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-primary">Add Friend</button>
                    </form>
                }
                else if (friendship.Status == "Pending" && friendship.RequestedBy == currentUserId)
                {
                    <span class="badge bg-warning">Request Sent</span>
                }
                else if (friendship.Status == "Pending" && friendship.RequestedBy != currentUserId)
                {
                    <form asp-action="Accept" asp-controller="Friendship" asp-route-id="@friendship.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Accept Request</button>
                    </form>
                }
                else if (friendship.Status == "Accepted")
                {
                    <span class="badge bg-success me-2">Friends</span>
                    <a asp-action="Conversation" asp-controller="Message" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary me-2">Message</a>
                    <form asp-action="Remove" asp-controller="Friendship" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove Friend</button>
                    </form>
                }
                else if (friendship.Status == "Blocked" && friendship.BlockedBy == currentUserId)
                {
                    <form asp-action="Unblock" asp-controller="Friendship" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Unblock</button>
                    </form>
                }
                @if (!isOwn)
                {
                    <hr />
                    <button class="btn btn-sm btn-outline-warning" data-bs-toggle="collapse" data-bs-target="#reportForm">Report User</button>
                    <div class="collapse mt-2" id="reportForm">
                        <form asp-action="Report" asp-controller="User" method="post">
                            <input type="hidden" name="reportedUserId" value="@Model.Id" />
                            <div class="mb-2">
                                <textarea name="reason" class="form-control" rows="2" placeholder="Reason for report" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-sm btn-warning">Submit Report</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <h4>Posts</h4>
        @if (posts != null && posts.Any())
        {
            @foreach (var post in posts)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>@post.Title</h5>
                        @if (!string.IsNullOrEmpty(post.Description))
                        {
                            <p>@Html.Raw(post.Description.Replace("\n", "<br />"))</p>
                        }
                        @if (post.VideoUrl.Contains("drive.google.com/file/d/"))
                        {
                            var fileId = post.VideoUrl.Split("/file/d/")[1].Split("/")[0];
                            <a href="@post.VideoUrl" target="_blank">
                                <img src="https://drive.google.com/thumbnail?id=@fileId&sz=w640" referrerpolicy="no-referrer" class="img-fluid rounded mb-2" alt="@post.Title" />
                            </a>
                        }
                        <div class="video-buttons">
                            <a href="@post.VideoUrl" target="_blank" class="btn btn-sm btn-outline-primary">Watch Video</a>
                            @if (isOwn)
                            {
                                <button onclick="deletePost(@post.Id, this)" class="btn btn-sm btn-outline-danger ms-2">Delete</button>
                            }
                            else if (isFriend)
                            {
                                <button class="btn btn-sm btn-outline-success ms-2" data-bs-toggle="collapse" data-bs-target="#feedback-@post.Id">Give Feedback</button>
                            }
                        </div>
                            @if (isFriend && !isOwn)
                            {
                                <div class="collapse mt-2" id="feedback-@post.Id">
                                    <form asp-controller="Post" asp-action="GiveFeedback" method="post">
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <div class="mb-2">
                                            <textarea name="content" class="form-control" rows="2" placeholder="Share your feedback on this video..." required></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-success">Submit Feedback</button>
                                    </form>
                                </div>
                            }
                            <span class="text-muted small float-end me-2">@post.PostedAt.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            }
        }
        else if (!isOwn && !isFriend)
        {
            <p class="text-muted">Add @Model.Username as a friend to see their posts.</p>
        }
        else
        {
            <p class="text-muted">No posts yet.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function deletePost(postId, btn) {
            if (confirm('Delete this post?')) {
                fetch('/Post/Delete/' + postId, { method: 'POST' })
                    .then(() => window.location.reload());
            }
        }
    </script>
}
