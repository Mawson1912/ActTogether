@model List<ActTogether.Models.User>
@{
    ViewData["Title"] = "Search Users";
    int currentUserId = ViewBag.CurrentUserId ?? 0;
}

<div class="main-content">
    <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>

    <h3>Search Users</h3>

    <form asp-action="Search" method="get" class="mb-4">
        <div class="input-group">
            <input name="query" value="@ViewBag.Query" class="form-control" placeholder="Search by username or name..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (Model.Any())
    {
        @foreach (var user in Model)
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@user.Username</strong>
                        @if (!string.IsNullOrEmpty(user.FullName))
                        {
                            <span class="text-muted">- @user.FullName</span>
                        }
                    </div>
                    <div>
                        <a asp-action="Profile" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">View Profile</a>
                    </div>
                </div>
            </div>
        }
    }
    else if (!string.IsNullOrEmpty(ViewBag.Query as string))
    {
        <p class="text-muted">No users found.</p>
    }
</div>
