@model List<ActTogether.Models.User>
@{
    ViewData["Title"] = "Search Users";
    var friendships = ViewBag.Friendships as List<ActTogether.Models.Friendship>;
    int currentUserId = ViewBag.CurrentUserId ?? 0;
}

<div class="main-content">
    <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>

    <h3>Search Users</h3>

    <form asp-action="Search" method="get" class="mb-4">
        <div class="input-group">
            <input name="query" value="@ViewBag.Query" class="form-control" placeholder="Search by username or name..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (Model.Any())
    {
        @foreach (var user in Model)
        {
            var fs = friendships?.FirstOrDefault(f =>
                (f.User1Id == currentUserId && f.User2Id == user.Id) ||
                (f.User1Id == user.Id && f.User2Id == currentUserId));

            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                            {
                                <img src="@user.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <span class="text-white" style="font-size: 1.25rem;">@user.Username.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                        </div>
                        <div>
                            <strong>@user.Username</strong>
                            @if (!string.IsNullOrEmpty(user.FullName))
                            {
                                <span class="text-muted">- @user.FullName</span>
                            }
                        </div>
                    </div>
                    <div>
                        @if (fs == null)
                        {
                            <form asp-action="SendRequest" asp-controller="Friendship" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success me-1">Add Friend</button>
                            </form>
                        }
                        else if (fs.Status == "Pending")
                        {
                            <span class="badge bg-warning me-1">Pending</span>
                        }
                        else if (fs.Status == "Accepted")
                        {
                            <span class="badge bg-success me-1">Friends</span>
                        }
                        else if (fs.Status == "Blocked")
                        {
                            <span class="badge bg-secondary me-1">Blocked</span>
                        }
                        <a asp-action="Profile" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">View Profile</a>
                    </div>
                </div>
            </div>
        }
    }
    else if (!string.IsNullOrEmpty(ViewBag.Query as string))
    {
        <p class="text-muted">No users found.</p>
    }
</div>
