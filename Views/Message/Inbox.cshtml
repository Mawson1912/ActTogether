@{
    ViewData["Title"] = "Messages";
    var userNames = ViewBag.UserNames as Dictionary<int, string>;
    var conversations = ViewBag.Conversations as dynamic;
}

<div class="main-content">
    <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back</a>

    <h3>Messages</h3>

    @if (conversations != null && ((IEnumerable<dynamic>)conversations).Any())
    {
        @foreach (var conv in conversations)
        {
            int otherId = conv.OtherUserId;
            string name = userNames != null && userNames.ContainsKey(otherId) ? userNames[otherId] : "Deleted";
            int unread = conv.UnreadCount;
            string preview = conv.Preview;
            DateTime sentAt = conv.SentAt;
            bool isFromMe = conv.IsFromMe;

            <a asp-action="Conversation" asp-route-id="@otherId" class="text-decoration-none">
                <div class="card mb-2 @(unread > 0 ? "border-primary" : "")">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <span class="text-white" style="font-size: 1.25rem;">@name.Substring(0, 1).ToUpper()</span>
                                </div>
                            </div>
                            <div>
                                <strong class="text-dark">@name</strong>
                                @if (unread > 0)
                                {
                                    <span class="badge bg-primary ms-2">@unread new</span>
                                }
                                <p class="text-muted small mb-0 mt-1">@(isFromMe ? "You: " : "")@preview</p>
                            </div>
                        </div>
                        <span class="text-muted small">@sentAt.ToString("dd MMM HH:mm")</span>
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <p class="text-muted">No conversations yet.</p>
    }
</div>
