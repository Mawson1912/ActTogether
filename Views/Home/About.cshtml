@{
    ViewData["Title"] = "About";
}

<div class="main-content">
    <h1>About ActTogether</h1>
    
    <div class="card mt-4">
        <div class="card-body">
            <h3 class="card-title">Our Mission</h3>
            <p class="card-text">
                ActTogether is a private social network designed specifically for actors. We provide a safe space for performers to share their self-tapes, showreels, and audition work with trusted friends and peers in the industry.
            </p>
            
            <h3 class="card-title mt-4">What We Offer</h3>
            <ul class="card-text">
                <li><strong>Private Sharing:</strong> Share your work only with people you trust</li>
                <li><strong>Honest Feedback:</strong> Get constructive notes from fellow actors</li>
                <li><strong>Community:</strong> Build a network of supportive peers</li>
                <li><strong>Growth:</strong> Learn from watching friends' tapes</li>
            </ul>
            
            <h3 class="card-title mt-4">Our Story</h3>
            <p class="card-text">
                Founded in 2026, ActTogether was created by actors, for actors. We understand the unique challenges of the audition process and the value of having a trusted circle of peers to support your journey.
            </p>
            
            <h3 class="card-title mt-4">Contact Us</h3>
            <p class="card-text">
                Have questions or feedback? We'd love to hear from you. Visit our <a asp-action="ContactUs">Contact Us</a> page to get in touch.
            </p>
        </div>
    </div>
</div>
