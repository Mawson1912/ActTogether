@model List<ActTogether.Models.Post>
@{
    ViewData["Title"] = "Feed";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var userNames = ViewBag.UserNames as Dictionary<int, string>;
    var reviewedPostIds = ViewBag.ReviewedPostIds as HashSet<int> ?? new HashSet<int>();
    var unreviewed = Model.Where(p => !reviewedPostIds.Contains(p.Id)).ToList();
    var reviewed = Model.Where(p => reviewedPostIds.Contains(p.Id)).ToList();
}

<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Your Feed</h3>
        <div>
            <a asp-controller="Post" asp-action="MyVideos" class="btn btn-outline-primary me-2">My Videos</a>
            <a asp-controller="Post" asp-action="Create" class="btn btn-primary">Share a Video</a>
        </div>
    </div>

    @if (Model.Any())
    {
        @foreach (var post in unreviewed)
        {
            var posterName = userNames != null && userNames.ContainsKey(post.UserId) ? userNames[post.UserId] : "Unknown";
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-2">
                        <div class="me-2">
                            @if (!string.IsNullOrEmpty(post.User?.ProfileImageUrl))
                            {
                                <img src="@post.User.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <span class="text-white" style="font-size: 1rem;">@posterName.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <h5>@post.Title</h5>
                                <span class="text-muted small">@post.PostedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                            <p class="text-muted small mb-0">Posted by <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId">@posterName</a></p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(post.Description))
                    {
                        <p>@Html.Raw(post.Description.Replace("\n", "<br />"))</p>
                    }
                    @if (post.VideoUrl.Contains("drive.google.com/file/d/"))
                    {
                        var fileId = post.VideoUrl.Split("/file/d/")[1].Split("/")[0];
                        <a href="@post.VideoUrl" target="_blank">
                            <img src="https://drive.google.com/thumbnail?id=@fileId&sz=w640" referrerpolicy="no-referrer" class="img-fluid rounded mb-2" alt="@post.Title" />
                        </a>
                    }
                    <div class="video-buttons">
                        <a href="@post.VideoUrl" target="_blank" class="btn btn-sm btn-outline-primary">Watch Video</a>
                        <button class="btn btn-sm btn-outline-success ms-2" data-bs-toggle="collapse" data-bs-target="#feedback-@post.Id">Give Feedback</button>
                    </div>
                <div class="collapse mt-2" id="feedback-@post.Id">
                    <form asp-controller="Post" asp-action="GiveFeedback" method="post">
                        <input type="hidden" name="postId" value="@post.Id" />
                        <div class="mb-2">
                            <textarea name="content" class="form-control" rows="2" placeholder="Share your feedback on this video..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-success">Submit Feedback</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (reviewed.Any())
    {
        <button class="btn btn-sm btn-outline-secondary mb-3" data-bs-toggle="collapse" data-bs-target="#reviewed-section">
            Already Reviewed (@reviewed.Count)
        </button>
        <div class="collapse" id="reviewed-section">
            @foreach (var post in reviewed)
            {
                var posterName = userNames != null && userNames.ContainsKey(post.UserId) ? userNames[post.UserId] : "Unknown";
                <div class="card mb-3 opacity-75">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-2">
                            <div class="me-2">
                                @if (!string.IsNullOrEmpty(post.User?.ProfileImageUrl))
                                {
                                    <img src="@post.User.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <span class="text-white" style="font-size: 1rem;">@posterName.Substring(0, 1).ToUpper()</span>
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h5>@post.Title</h5>
                                    <span class="text-muted small">@post.PostedAt.ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                                <p class="text-muted small mb-0">Posted by <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId">@posterName</a></p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(post.Description))
                        {
                            <p>@Html.Raw(post.Description.Replace("\n", "<br />"))</p>
                        }
                        @if (post.VideoUrl.Contains("drive.google.com/file/d/"))
                        {
                            var fileId = post.VideoUrl.Split("/file/d/")[1].Split("/")[0];
                            <a href="@post.VideoUrl" target="_blank">
                                <img src="https://drive.google.com/thumbnail?id=@fileId&sz=w640" referrerpolicy="no-referrer" class="img-fluid rounded mb-2" alt="@post.Title" />
                            </a>
                        }
                        <div class="video-buttons">
                            <a href="@post.VideoUrl" target="_blank" class="btn btn-sm btn-outline-primary">Watch Video</a>
                            <button class="btn btn-sm btn-outline-success ms-2" data-bs-toggle="collapse" data-bs-target="#feedback-@post.Id">Give More Feedback</button>
                            <form asp-controller="Post" asp-action="Dismiss" method="post" class="d-inline">
                                <input type="hidden" name="postId" value="@post.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2" onclick="return confirm('Dismiss this video from your feed?')">Dismiss</button>
                            </form>
                        </div>
                        <div class="collapse mt-2" id="feedback-@post.Id">
                            <form asp-controller="Post" asp-action="GiveFeedback" method="post">
                                <input type="hidden" name="postId" value="@post.Id" />
                                <div class="mb-2">
                                    <textarea name="content" class="form-control" rows="2" placeholder="Share your feedback on this video..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-sm btn-success">Submit Feedback</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="text-center mt-5">
        <h4>No posts in your feed yet!</h4>
        <p class="text-muted">Add friends to see their videos here.</p>
    </div>
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @if (currentPage > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">&laquo; Prev</a></li>
            }
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i">@i</a></li>
            }
            @if (currentPage < totalPages)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next &raquo;</a></li>
            }
        </ul>
    </nav>
}
</div>
